# Fullstack-EMS Root Environment Variables (Template)
# Copy this to .env and adjust values for your environment

MONGODB_URI="mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/fullstack-ems"
JWT_SECRET="your_strong_jwt_secret_here"
ADMIN_EMAIL="admin@example.com"

# Inngest Background Tasks
INNGEST_EVENT_KEY="your_inngest_event_key"
INNGEST_SIGNING_KEY="your_inngest_signing_key"

# Brevo SMTP Configuration
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
SENDER_EMAIL="admin@example.com"

# Google Gemini AI API Key
GEMINI_API_KEY="your_gemini_api_key_here"

# Upstash Redis
REDIS_URI="rediss://default:...@lucky-pangolin-227534.upstash.io:6379"

# CloudAMQP RabbitMQ
RABBITMQ_URI="amqps://...gerbil.rmq.cloudamqp.com/..."
