# ==========================================
# Fullstack-EMS Backend Environment Variables
# ==========================================
# In Render: Add these under "Environment" in your Web Service dashboard.

# Server / Gateway Port (Render automatically injects PORT=10000)
PORT=4000
NODE_ENV=production

# Database (Required: MongoDB Atlas connection URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ems_production?retryWrites=true&w=majority

# JWT Authentication (Required: Any strong secret string)
JWT_SECRET=super_secret_jwt_key_ems_2026_change_this

# System Administrator Email (Used for seeding & alerts)
ADMIN_EMAIL=admin@ems.com

# Optional: Cloud Redis (e.g., Upstash Redis, Redis Cloud)
# If omitted or unavailable, backend automatically falls back to in-memory TTL caching
REDIS_URI=rediss://default:<password>@<host>:<port>

# Optional: Cloud RabbitMQ (e.g., CloudAMQP)
# If omitted or unavailable, backend automatically falls back to in-memory event bus with retry + DLQ
RABBITMQ_URI=amqps://<user>:<password>@<host>/<vhost>

# Optional: Google Gemini AI API Key (for Chatbot Assistant)
GEMINI_API_KEY=AIzaSy...

# Optional: SMTP Email Notifications
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SENDER_EMAIL=your_email@gmail.com
